{"reg01":[["d-single","printf(\"%d\", 42);"],["d-neg-nl","printf(\"%d\\n\", -7);"],["s-basic","printf(\"%s\", \"hello\");"],["multi-nl","printf(\"%d\\n\", 1); printf(\"%s\\n\", \"ab\"); printf(\"%f\\n\", 0.5);"],["f-basic","printf(\"%f\", 2.5);"],["f-dot1","printf(\"%.1f\", 3.14159);"],["mixed-dsf","printf(\"%d %s %f\", 1, \"x\", 2.5);"],["mixed-fd","printf(\"%f %d\", 1.5, 7);"],["c-char","printf(\"%c\", 65);"],["i-form","printf(\"%i\", 123);"],["percent","printf(\"100%%\");"],["u-form","unsigned int u = 42; printf(\"%u\", u);"],["nan-var","double x = 0.0 / 0.0; printf(\"%f\", x);"],["nan-direct","printf(\"%f\", 0.0 / 0.0);"],["inf-pos","printf(\"%f\", 1.0 / 0.0);"],["inf-neg","printf(\"%f\", -1.0 / 0.0);"],["inf-var","double a = 5.0; double b = a / 0.0; printf(\"%f\", b);"],["width-form","printf(\"%5d\", 42);"],["ld-form","printf(\"%ld\", 42L);"]],"reg02":[["div-decl","div_t d = div(10, 3); printf(\"%d %d\", d.quot, d.rem);"],["div-direct","printf(\"%d %d\", div(10, 3).quot, div(10, 3).rem);"],["div-neg","printf(\"%d %d\", div(-7, 2).quot, div(-7, 2).rem);"],["ldiv-direct","printf(\"%ld %ld\", ldiv(10L, 3L).quot, ldiv(10L, 3L).rem);"],["strcmp-lit-neg","printf(\"%d\", strcmp(\"abc\", \"abd\"));"],["strcmp-eq","printf(\"%d\", strcmp(\"abc\", \"abc\"));"],["strcmp-arr","char a[8] = \"abc\"; char b[8] = \"abd\"; printf(\"%d\", strcmp(a, b));"],["strncmp","printf(\"%d %d\", strncmp(\"abcx\", \"abcy\", 3), strncmp(\"abcx\", \"abcy\", 4));"],["strlen","printf(\"%d %d\", (int)strlen(\"hello\"), (int)strlen(\"\"));"],["strchr","char buf[8] = \"hello\"; printf(\"%s\", strchr(buf, 'l'));"],["strrchr","char buf[8] = \"hello\"; printf(\"%s\", strrchr(buf, 'l'));"],["strstr","char buf[16] = \"hello world\"; printf(\"%s\", strstr(buf, \"wor\"));"],["strstr-null","char buf[8] = \"abc\"; printf(\"%d\", strstr(buf, \"z\") == NULL);"],["strcpy-pipe","char buf[32]; strcpy(buf, \"foo\"); strcat(buf, \"bar\"); printf(\"%s %d %d\", buf, (int)strlen(buf), strcmp(buf, \"foobar\"));"]]}