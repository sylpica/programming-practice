[
  ["implicit output", "$x=2+3\n$x", [["5"]]],
  [
    "write host excluded from pipeline",
    "$r=Write-Host \"host\"\n$r\nWrite-Output 3",
    [["3"]]
  ],
  ["case insensitive variables", "$Name=\"Alice\"\n$name", [["Alice"]]],
  [
    "quote interpolation",
    "$x=3\n\"n=$x next=$($x+1)\"\n'$x'",
    [["n=3 next=4", "$x"]]
  ],
  ["backtick escape", "Write-Output \"a`t$true\"", [["a\tTrue"]]],
  ["single quote escape", "Write-Output 'it''s'", [["it's"]]],
  ["array and count", "$a=@(2,4,6)\n$a[1]\n$a.Count", [["4", "3"]]],
  [
    "empty array retained",
    "$a=@()\n$a.Count\n$a+=2\n$a+=4\n$a.Count",
    [["0", "2"]]
  ],
  ["single array retained", "$a=@(1)\n$a.Count\n$a+=2\n$a.Count", [["1", "2"]]],
  ["reference assignment", "$a=@(1,2)\n$b=$a\n$b[0]=9\n$a", [["9", "2"]]],
  [
    "hashtable access",
    "$h=@{Name=\"Alice\"; N=2}\n$h[\"name\"]\n$h.N=3\n$h.N",
    [["Alice", "3"]]
  ],
  [
    "null truth",
    "if($null){1}else{2}\nif(@()){3}else{4}\nif(@($false,$false)){5}",
    [["2", "4", "5"]]
  ],
  ["string truth", "if(\"False\"){1}else{2}\nif(\"\"){3}else{4}", [["1", "4"]]],
  [
    "numeric comparison",
    "1 -eq \"01\"\n\"01\" -eq 1\n0 -eq $null",
    [["True", "False", "False"]]
  ],
  [
    "case comparison",
    "\"Hello\" -eq \"hello\"\n\"Hello\" -ceq \"hello\"",
    [["True", "False"]]
  ],
  [
    "like match",
    "\"abc.txt\" -like \"*.txt\"\n\"abc123\" -match \"[0-9]+\"\n$Matches[0]",
    [["True", "True", "123"]]
  ],
  ["array comparison", "@(1,2,3) -gt 1", [["2", "3"]]],
  ["if elseif", "IF(0){1}ELSEIF(2 -gt 1){2}else{3}", [["2"]]],
  ["foreach", "foreach($x in 1..3){$x*2}", [["2", "4", "6"]]],
  ["for", "for($i=0;$i -lt 3;$i++){$i}", [["0", "1", "2"]]],
  ["while", "$i=0\nwhile($i -lt 3){$i;$i++}", [["0", "1", "2"]]],
  ["do while", "$i=0\ndo{$i++;$i}while($i -lt 2)", [["1", "2"]]],
  [
    "break continue",
    "foreach($x in 1..5){if($x -eq 2){continue};if($x -eq 4){break};$x}",
    [["1", "3"]]
  ],
  ["switch", "switch(2){1{\"one\"}2{\"two\"}default{\"other\"}}", [["two"]]],
  [
    "switch multiple matches",
    "switch(2){2{\"first\"}2{\"second\"}default{\"other\"}}",
    [["first", "second"]]
  ],
  [
    "switch default per item",
    "switch(1,3){1{\"one\"}default{\"other\"}}",
    [["one", "other"]]
  ],
  ["switch break", "switch(1,2){1{\"one\";break}2{\"two\"}}", [["one"]]],
  ["function outputs", "function Values {1;return 2;3}\nValues", [["1", "2"]]],
  [
    "function params",
    "function Add {param($a,$b) $a+$b}\nAdd 2 3\nAdd -b 4 -a 1",
    [["5", "5"]]
  ],
  ["function local scope", "$x=1\nfunction F {$x=2;$x}\nF\n$x", [["2", "1"]]],
  [
    "function array argument",
    "function F {param($a)foreach($x in $a){$x*2}}\n$r=F @(1,2,3)\n$r",
    [["2", "4", "6"]]
  ],
  [
    "pipeline object properties",
    "$a=[pscustomobject]@{Name=\"A\";N=2}\n$a | ForEach-Object {$_.N=3}\n$a.N",
    [["3"]]
  ],
  [
    "pipeline filter",
    "1..5 | Where-Object {$_ -gt 2} | ForEach-Object {$PSItem*2}",
    [["6", "8", "10"]]
  ],
  [
    "pipeline select expand",
    "$r=@([pscustomobject]@{N=2},[pscustomobject]@{N=4})\n$r | Select-Object -ExpandProperty N",
    [["2", "4"]]
  ],
  ["pipeline write-output", "1..3 | Write-Output", [["1", "2", "3"]]],
  ["sort", "@(3,1,2)|Sort-Object -Descending", [["3", "2", "1"]]],
  [
    "select first last",
    "1..5 | Select-Object -First 2\n1..5 | Select-Object -Skip 3",
    [["1", "2", "4", "5"]]
  ],
  [
    "get location",
    "Get-Location | Select-Object -ExpandProperty Path",
    [["C:\\Practice"]]
  ],
  [
    "set location",
    "Set-Location logs\n(Get-Location).Path",
    [["C:\\Practice\\logs"]]
  ],
  [
    "test path",
    "Test-Path notes.txt\nTest-Path missing.txt",
    [["True", "False"]]
  ],
  [
    "file write read",
    "Set-Content out.txt \"A\"\nAdd-Content out.txt \"B\"\nGet-Content out.txt",
    [["A", "B"]]
  ],
  ["automatic variables", "$LASTEXITCODE\nWrite-Output 1\n$?", [["1", "True"]]],
  ["explicit null array", "@($null).Count", [["1"]]],
  ["void array", "@(Write-Host \"host\").Count", [["0"]]],
  ["null foreach array", "$n=0;foreach($x in @($null)){$n++};$n", [["1"]]],
  ["null foreach scalar", "$n=0;foreach($x in $null){$n++};$n", [["0"]]],
  ["null pipeline", "$null|ForEach-Object {1}", [["1"]]],
  ["measure null", "($null|Measure-Object).Count", [["0"]]],
  ["select null", "@($null|Select-Object -First 1).Count", [["0"]]],
  ["sort null", "@($null|Sort-Object).Count", [["0"]]],
  [
    "typed hashtable keys",
    "$h=@{};$h[1]=\"numeric\";$h[\"1\"]=\"text\";$h[1];$h[\"1\"];$h.Count",
    [["numeric", "text", "2"]]
  ],
  [
    "hashtable member shadow",
    "@{Count=9;Keys=3}.Count\n@{Count=9;Keys=3}.Keys",
    [["9", "3"]]
  ],
  [
    "floating conversion",
    "$x=0.3+0.6\n\"value=$x\"\n\"small=$(1e-7)\"",
    [["value=0.9", "small=1E-07"]]
  ],
  [
    "Test-Path empty and wildcard",
    "Test-Path \"\"\nTest-Path \" \"\nTest-Path *.txt\nTest-Path *.absent",
    [["False", "False", "True", "False"]]
  ],
  [
    "switch converts numbers to strings",
    "switch(1){\"01\"{\"bad\"};\"1\"{\"yes\"}}",
    [["yes"]]
  ],
  [
    "explicit null parameter and local args",
    "function F {param($x=\"default\") \"arg=$x\"; $args.Count}\nF $null",
    [["arg=", "0"]]
  ],
  [
    "Copy-Item overwrites a normal existing file",
    "Copy-Item notes.txt copied.txt\nSet-Content copied.txt old\nCopy-Item notes.txt copied.txt\nGet-Content copied.txt",
    [["学習メモ"]]
  ]
]
